{
	"name": "df_NHTSAComplaintsToParquet",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "ComplaintsDelimitedTextDS",
						"type": "DatasetReference"
					},
					"name": "sourceNHTSA"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "ds_ADLS_Parquet",
						"type": "DatasetReference"
					},
					"name": "sinkParquet",
					"rejectedDataLinkedService": {
						"referenceName": "ls_ADLS_Gen2",
						"type": "LinkedServiceReference"
					}
				}
			],
			"transformations": [
				{
					"name": "filterManufacturer"
				},
				{
					"name": "derivedFileName"
				}
			],
			"scriptLines": [
			"source(output(",
			"          {_col0_} as string,",
			"          {_col1_} as string,",
			"          {_col2_} as string,",
			"          {_col3_} as string,",
			"          {_col4_} as string,",
			"          {_col5_} as string,",
			"          {_col6_} as string,",
			"          {_col7_} as string,",
			"          {_col8_} as string,",
			"          {_col9_} as short,",
			"          {_col10_} as short,",
			"          {_col11_} as string,",
			"          {_col12_} as string,",
			"          {_col13_} as string,",
			"          {_col14_} as string,",
			"          {_col15_} as string,",
			"          {_col16_} as string,",
			"          {_col17_} as integer,",
			"          {_col18_} as short,",
			"          {_col19_} as string,",
			"          {_col20_} as string,",
			"          {_col21_} as string,",
			"          {_col22_} as string,",
			"          {_col23_} as string,",
			"          {_col24_} as string,",
			"          {_col25_} as string,",
			"          {_col26_} as short,",
			"          {_col27_} as string,",
			"          {_col28_} as string,",
			"          {_col29_} as string,",
			"          {_col30_} as string,",
			"          {_col31_} as short,",
			"          {_col32_} as string,",
			"          {_col33_} as string,",
			"          {_col34_} as string,",
			"          {_col35_} as string,",
			"          {_col36_} as string,",
			"          {_col37_} as string,",
			"          {_col38_} as string,",
			"          {_col39_} as string,",
			"          {_col40_} as string,",
			"          {_col41_} as string,",
			"          {_col42_} as string,",
			"          {_col43_} as string,",
			"          {_col44_} as string,",
			"          {_col45_} as string,",
			"          {_col46_} as string,",
			"          {_col47_} as string,",
			"          {_col48_} as string",
			"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> sourceNHTSA",
				"sourceNHTSA filter(!endsWith({_col2_}, \".\")) ~> filterManufacturer",
				"filterManufacturer derive(filename = concat({_col2_}, '.parquet')) ~> derivedFileName",
			"derivedFileName sink(allowSchemaDrift: true,",
			"     validateSchema: false,",
			"     format: 'parquet',",
			"     rowUrlColumn:'filename',",
			"     umask: 0022,",
			"     preCommands: [],",
			"     postCommands: [],",
			"     skipDuplicateMapInputs: true,",
			"     skipDuplicateMapOutputs: true,",
			"     mapColumn(",
			"          CMPLID = {_col0_},",
			"          ODINO = {_col1_},",
			"          MFR_NAME = {_col2_},",
			"          MAKETXT = {_col3_},",
			"          MODELTXT = {_col4_},",
			"          YEARTXT = {_col5_},",
			"          CRASH = {_col6_},",
			"          FAILDATE = {_col7_},",
			"          FIRE = {_col8_},",
			"          INJURED = {_col9_},",
			"          DEATHS = {_col10_},",
			"          COMPDESC = {_col11_},",
			"          CITY = {_col12_},",
			"          STATE = {_col13_},",
			"          VIN = {_col14_},",
			"          DATEA = {_col15_},",
			"          LDATE = {_col16_},",
			"          MILES = {_col17_},",
			"          OCCURENCES = {_col18_},",
			"          CDESCR = {_col19_},",
		"          CMPL_TYPE = {_col20_},",
		"          POLICE_RPT_YN = {_col21_},",
		"          PURCH_DT = {_col22_},",
		"          ORIG_OWNER_YN = {_col23_},",
		"          ANTI_BRAKES_YN = {_col24_},",
		"          CRUISE_CONT_YN = {_col25_},",
		"          NUM_CYLS = {_col26_},",
		"          DRIVE_TRAIN = {_col27_},",
		"          FUEL_SYS = {_col28_},",
		"          FUEL_TYPE = {_col29_},",
		"          TRANS_TYPE = {_col30_},",
		"          VEH_SPEED = {_col31_},",
		"          DOT = {_col32_},",
		"          TIRE_SIZE = {_col33_},",
		"          LOC_OF_TIRE = {_col34_},",
		"          TIRE_FAIL_TYPE = {_col35_},",
		"          ORIG_EQUIP_YN = {_col36_},",
		"          MANUF_DT = {_col37_},",
		"          SEAT_TYPE = {_col38_},",
		"          RESTRAINT_TYPE = {_col39_},",
		"          DEALER_NAME = {_col40_},",
		"          DEALER_TEL = {_col41_},",
		"          DEALER_CITY = {_col42_},",
		"          DEALER_STATE = {_col43_},",
		"          DEALER_ZIP = {_col44_},",
		"          PROD_TYPE = {_col45_},",
		"          REPAIRED_YN = {_col46_},",
		"          MEDICAL_ATTN = {_col47_},",
		"          VEHICLES_TOWED_YN = {_col48_},",
			"          filename",
			"     )) ~> sinkParquet"
			]
		}
	}
}