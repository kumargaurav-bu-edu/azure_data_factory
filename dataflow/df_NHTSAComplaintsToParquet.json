{
	"name": "df_NHTSAComplaintsToParquet",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "ComplaintsDelimitedTextDS",
						"type": "DatasetReference"
					},
					"name": "sourceNHTSA"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "ds_ADLS_Parquet",
						"type": "DatasetReference"
					},
					"name": "sinkParquet",
					"rejectedDataLinkedService": {
						"referenceName": "ls_ADLS_Gen2",
						"type": "LinkedServiceReference"
					}
				}
			],
			"transformations": [
				{
					"name": "filterManufacturer"
				},
				{
					"name": "derivedFileName"
				}
			],
			"scriptLines": [
				"source(output(",
				"          {_col0_} as short,",
				"          {_col1_} as integer,",
				"          {_col2_} as string,",
				"          {_col3_} as string,",
				"          {_col4_} as string,",
				"          {_col5_} as short,",
				"          {_col6_} as boolean,",
				"          {_col7_} as date,",
				"          {_col8_} as boolean,",
				"          {_col9_} as short,",
				"          {_col10_} as boolean,",
				"          {_col11_} as string,",
				"          {_col12_} as string,",
				"          {_col13_} as string,",
				"          {_col14_} as string,",
				"          {_col15_} as date,",
				"          {_col16_} as date,",
				"          {_col17_} as string,",
				"          {_col18_} as short,",
				"          {_col19_} as string,",
				"          {_col20_} as string,",
				"          {_col21_} as boolean,",
				"          {_col22_} as string,",
				"          {_col23_} as boolean,",
				"          {_col24_} as boolean,",
				"          {_col25_} as boolean,",
				"          {_col26_} as string,",
				"          {_col27_} as string,",
				"          {_col28_} as string,",
				"          {_col29_} as string,",
				"          {_col30_} as string,",
				"          {_col31_} as boolean,",
				"          {_col32_} as string,",
				"          {_col33_} as string,",
				"          {_col34_} as string,",
				"          {_col35_} as string,",
				"          {_col36_} as boolean,",
				"          {_col37_} as string,",
				"          {_col38_} as string,",
				"          {_col39_} as string,",
				"          {_col40_} as string,",
				"          {_col41_} as string,",
				"          {_col42_} as string,",
				"          {_col43_} as string,",
				"          {_col44_} as string,",
				"          {_col45_} as string,",
				"          {_col46_} as boolean,",
				"          {_col47_} as boolean,",
				"          {_col48_} as boolean",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> sourceNHTSA",
				"sourceNHTSA filter(!endsWith({_col2_}, \".\")) ~> filterManufacturer",
				"filterManufacturer derive(filename = concat({_col2_}, '.parquet')) ~> derivedFileName",
			"derivedFileName sink(allowSchemaDrift: true,",
			"     validateSchema: false,",
			"     format: 'parquet',",
			"     rowUrlColumn:'filename',",
			"     umask: 0022,",
			"     preCommands: [],",
			"     postCommands: [],",
			"     skipDuplicateMapInputs: true,",
			"     skipDuplicateMapOutputs: true,",
			"     mapColumn(",
			"          CMPLID = {_col0_},",
			"          ODINO = {_col1_},",
			"          MFR_NAME = {_col2_},",
			"          MAKETXT = {_col3_},",
			"          MODELTXT = {_col4_},",
			"          YEARTXT = {_col5_},",
			"          CRASH = {_col6_},",
			"          FAILDATE = {_col7_},",
			"          FIRE = {_col8_},",
			"          INJURED = {_col9_},",
			"          DEATHS = {_col10_},",
			"          COMPDESC = {_col11_},",
			"          CITY = {_col12_},",
			"          STATE = {_col13_},",
			"          VIN = {_col14_},",
			"          DATEA = {_col15_},",
			"          LDATE = {_col16_},",
			"          MILES = {_col17_},",
			"          OCCURENCES = {_col18_},",
			"          CDESCR = {_col19_},",
			"          CMPL_TYPE = {_col20_},",
			"          FUTURE_USE = {_col21_},",
			"          ORIG_OWNER_YN = {_col22_},",
			"          ANTI_BRAKES_YN = {_col23_},",
			"          CRUISE_CONT_YN = {_col24_},",
			"          NUM_CYLS = {_col25_},",
			"          DRIVE_TRAIN = {_col26_},",
			"          FUEL_SYS = {_col27_},",
			"          FUEL_TYPE = {_col28_},",
			"          TRANS_TYPE = {_col29_},",
			"          VEH_SPEED = {_col30_},",
			"          DOT_NUM = {_col31_},",
			"          TIRE_SIZE = {_col32_},",
			"          LOC_OF_TIRE = {_col33_},",
			"          TIRE_FAIL_TYPE = {_col34_},",
			"          ORIG_EQUIP_YN = {_col35_},",
			"          MANUF_DT = {_col36_},",
			"          SEAT_TYPE = {_col37_},",
			"          RESTRAINT_TYPE = {_col38_},",
			"          DEALER_NAME = {_col39_},",
			"          DEALER_TEL = {_col40_},",
			"          DEALER_CITY = {_col41_},",
			"          DEALER_STATE = {_col42_},",
			"          DEALER_ZIP = {_col43_},",
			"          PROD_TYPE = {_col44_},",
			"          REPAIRED_YN = {_col45_},",
			"          MEDICAL_ATTN = {_col46_},",
			"          VEHICLES_TOWED_YN = {_col47_},",
			"          PURCH_DT = {_col48_},",
			"          filename",
			"     )) ~> sinkParquet"
			]
		}
	}
}