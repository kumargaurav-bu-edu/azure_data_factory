{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "datafactory94cca4"
		},
		"AzureBlobStorageForZipExtraction_connectionString": {
			"type": "secureString",
			"metadata": "Secure string for 'connectionString' of 'AzureBlobStorageForZipExtraction'"
		},
		"AzureBlobStorageH1b_connectionString": {
			"type": "secureString",
			"metadata": "Secure string for 'connectionString' of 'AzureBlobStorageH1b'"
		},
		"AzureSqlDatabaseKgComplaints_password": {
			"type": "secureString",
			"metadata": "Secure string for 'password' of 'AzureSqlDatabaseKgComplaints'"
		},
		"AzureSqlDatabaseKgComplaints_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "kgmod4server-20260221.database.windows.net"
		},
		"AzureSqlDatabaseKgComplaints_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "kgmod4db"
		},
		"AzureSqlDatabaseKgComplaints_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "omdsmod4admin"
		},
		"HttpServer_ComplaintsData_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://static.nhtsa.gov/odi/ffdd/cmpl/FLAT_CMPL.zip"
		},
		"containerUri": {
			"type": "string",
			"metadata": "URI to storage account containing linked ARM templates"
		},
		"containerSasToken": {
			"type": "string",
			"metadata": "Sas token to storage account containing linked ARM templates"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "datafactory94cca4_ArmTemplate_0",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_0.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					},
					"AzureBlobStorageForZipExtraction_connectionString": {
						"value": "[parameters('AzureBlobStorageForZipExtraction_connectionString')]"
					},
					"AzureBlobStorageH1b_connectionString": {
						"value": "[parameters('AzureBlobStorageH1b_connectionString')]"
					},
					"AzureSqlDatabaseKgComplaints_password": {
						"value": "[parameters('AzureSqlDatabaseKgComplaints_password')]"
					},
					"AzureSqlDatabaseKgComplaints_properties_typeProperties_server": {
						"value": "[parameters('AzureSqlDatabaseKgComplaints_properties_typeProperties_server')]"
					},
					"AzureSqlDatabaseKgComplaints_properties_typeProperties_database": {
						"value": "[parameters('AzureSqlDatabaseKgComplaints_properties_typeProperties_database')]"
					},
					"AzureSqlDatabaseKgComplaints_properties_typeProperties_userName": {
						"value": "[parameters('AzureSqlDatabaseKgComplaints_properties_typeProperties_userName')]"
					},
					"HttpServer_ComplaintsData_properties_typeProperties_url": {
						"value": "[parameters('HttpServer_ComplaintsData_properties_typeProperties_url')]"
					}
				}
			},
			"dependsOn": []
		}
	]
}