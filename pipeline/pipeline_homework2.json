							},
							{
								"source": {
									"path": "$['production_countries'][0]['name']"
								}
							},
							{
								"source": {
									"path": "$['release_date']"
								}
							},
							{
								"source": {
									"path": "$['revenue']"
								}
							},
							{
								"source": {
									"path": "$['runtime']"
								}
							},
							{
								"source": {
									"path": "$['spoken_languages'][0]['iso_639_1']"
								}
							},
							{
								"source": {
									"path": "$['spoken_languages'][0]['name']"
								}
							},
							{
								"source": {
									"path": "$['status']"
								}
							},
							{
								"source": {
									"path": "$['tagline']"
								}
							},
							{
								"source": {
									"path": "$['title']"
								}
							},
							{
								"source": {
									"path": "$['vote_average']"
								}
							},
							{
								"source": {
									"path": "$['vote_count']"
								}
							}
