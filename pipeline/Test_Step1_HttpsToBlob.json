{
	"name": "Test_Step1_HttpsToBlob",
	"properties": {
		"description": "Test only Step 1: Copy FLAT_CMPL.zip from HTTPS to Blob (binary, no compression). Run this to verify the blob matches the source before testing unzip.",
		"activities": [
			{
				"name": "CopyComplaintsDataFromHttps",
				"type": "Copy",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "BinarySource",
						"storeSettings": {
							"type": "HttpReadSettings",
							"requestMethod": "GET"
						},
						"formatSettings": {
							"type": "BinaryReadSettings"
						}
					},
					"sink": {
						"type": "BinarySink",
						"storeSettings": {
							"type": "AzureBlobStorageWriteSettings"
						}
					},
					"enableStaging": false
				},
				"inputs": [
					{
						"referenceName": "ComplaintsHttpDS",
						"type": "DatasetReference"
					}
				],
				"outputs": [
					{
						"referenceName": "ComplaintsBlobStageDS",
						"type": "DatasetReference"
					}
				]
			}
		],
		"annotations": []
	},
	"type": "Microsoft.DataFactory/factories/pipelines"
}
