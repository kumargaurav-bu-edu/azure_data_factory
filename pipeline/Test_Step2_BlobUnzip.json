{
	"name": "Test_Step2_BlobUnzip",
	"properties": {
		"description": "Test Step 2 (Professor's approach): Unzip FLAT_CMPL.zip with preserveZipFileNameAsFolder=false in storeSettings. Files go directly into output/extracted/ with original names. Run after Test_Step1_HttpsToBlob.",
		"activities": [
			{
				"name": "UnzipComplaintsFile",
				"type": "Copy",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "BinarySource",
						"storeSettings": {
							"type": "AzureBlobStorageReadSettings",
							"preserveZipFileNameAsFolder": false,
							"recursive": false,
							"wildcardFileName": "*.txt"
						},
						"formatSettings": {
							"type": "BinaryReadSettings",
							"compressionProperties": {
								"type": "ZipDeflateReadSettings",
								"preserveZipFileNameAsFolder": false
							}
						}
					},
					"sink": {
						"type": "BinarySink",
						"storeSettings": {
							"type": "AzureBlobStorageWriteSettings",
							"copyBehavior": "PreserveHierarchy"
						}
					},
					"enableStaging": false
				},
				"inputs": [
					{
						"referenceName": "ComplaintsBlobStageZipDS",
						"type": "DatasetReference"
					}
				],
				"outputs": [
					{
						"referenceName": "ComplaintsExtractedDS",
						"type": "DatasetReference"
					}
				]
			}
		],
		"annotations": []
	},
	"type": "Microsoft.DataFactory/factories/pipelines"
}